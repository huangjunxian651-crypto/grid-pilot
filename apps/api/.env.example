# ── AI 网格推荐 ───────────────────────────────────────────
# 提供方：anthropic（默认）或 openai
AI_PROVIDER=anthropic
# Claude（标准计费 API key）。模型可选，默认 claude-opus-4-8
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
# OpenAI / 兼容端点（AI_PROVIDER=openai 时）
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=
# ⚠️ 请勿使用「coding plan / 订阅制编码套餐」的 key（如 Claude Code 订阅 key）：
#    这类 key 在直接 API 调用上可能被限流或拒绝，请使用标准计费的 API key。
