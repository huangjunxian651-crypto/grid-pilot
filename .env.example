# ============================================================
# GridPilot Unified Configuration
# Copy to .env and adjust values for your environment.
# ============================================================

# --- Service Ports ---
WEB_PORT=3300
API_PORT=3301
DB_PORT=25432
REDIS_PORT=26379

# --- Host Bindings ---
# Use 0.0.0.0 to listen on all interfaces (allows LAN access).
# Use 127.0.0.1 to restrict to localhost only.
WEB_HOST=0.0.0.0
API_HOST=0.0.0.0

# --- URLs ---
# WEB_URL: origin that the API allows for CORS
WEB_URL=http://localhost:3300

# API_URL: base URL the Web frontend uses for API rewrites & socket fallback
API_URL=http://localhost:3301

# NEXT_PUBLIC_API_URL: exposed to the browser for socket fallback (SSR)
NEXT_PUBLIC_API_URL=http://localhost:3301

# NEXT_PUBLIC_API_PORT: exposed to the browser so socket URL can use correct port
NEXT_PUBLIC_API_PORT=3301

# --- Development ---
# Extra origins allowed for Next.js dev HMR (comma-separated).
# By default all local IPs are auto-detected; use this for manual overrides.
# DEV_EXTRA_ORIGINS=192.168.8.100

# --- Database ---
DATABASE_URL=postgresql://gridpilot:gridpilot@localhost:25432/gridpilot

# --- Redis ---
REDIS_URL=redis://localhost:26379

# --- Security ---
# Base64-encoded 32-byte key for AES-256-GCM credential encryption.
# Generate with: openssl rand -base64 32   (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
ENCRYPTION_KEY=your-key-REPLACE-with-output-of-openssl-rand-base64-32
